# Trading Journal — environment variables
#
# Copy to .env.local for local development (`cp .env.example .env.local`) and add
# the same keys to your hosting provider (e.g. Vercel → Settings → Environment
# Variables). Nothing here is required just to run `npm run build` — features
# that lack their key degrade to a clear message instead of crashing.

# ─── Supabase (required for sign-in, sync, alerts, broker accounts) ───
# Project Settings → API. The anon key is safe to expose; it is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses row level security, so it must never be prefixed with
# NEXT_PUBLIC_ or used in client code. Needed only by the price-alert cron job.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── AI features (optional) ───
# Without this key the AI coach and the economic-event analysis fall back to
# built-in canned analysis, and the calendar page still works.
OPENAI_API_KEY=sk-...

# ─── Broker trade sync via MetaApi (optional) ───
# https://metaapi.cloud — required for the Accounts page to connect MT4/MT5.
METAAPI_TOKEN=your-metaapi-token

# ─── Price alerts (optional) ───
# https://twelvedata.com — free tier: 8 requests/minute, 800/day.
TWELVE_DATA_API_KEY=your-twelve-data-key

# ─── Alert emails via Resend (optional) ───
# https://resend.com/api-keys. Until you verify a sending domain, Resend only
# delivers from onboarding@resend.dev to the address you signed up with.
RESEND_API_KEY=re_...
# e.g. "Trading Journal <alerts@yourdomain.com>"
RESEND_FROM_EMAIL=onboarding@resend.dev

# ─── Cron authentication (required by /api/cron/check-price-alerts) ───
# Any long random string. Must match the CRON_SECRET repository secret used by
# .github/workflows/check-price-alerts.yml. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=replace-me-with-a-long-random-string
